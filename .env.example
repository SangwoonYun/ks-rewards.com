# Copy to .env (local `bun run dev`) or .env.production (docker compose) and fill in the values.
# Only NUXT_-prefixed variables are read (Nuxt runtimeConfig); defaults are in nuxt.config.ts.

# --- Required in production (the server refuses to start with placeholders) ---
NUXT_ADMIN_USERNAME=admin
NUXT_ADMIN_PASSWORD=
# Random, at least 32 characters, e.g. `openssl rand -hex 32`
NUXT_ADMIN_JWT_SECRET=

# --- Optional ---
# NUXT_DB_PATH=./data/ks-rewards.db
# NUXT_KS_REDEEM_URL=https://kingshot-giftcode.centurygame.com/api/gift_code
# NUXT_KS_ENCRYPT_KEY=mN4!pQs6JrYwV9
# NUXT_GIFT_CODE_API_URL=http://ks-gift-code-api.whiteout-bot.com/giftcode_api.php
# NUXT_GIFT_CODE_API_KEY=super_secret_bot_token_nobody_will_ever_find

# Retries and rate limiting (milliseconds)
# NUXT_MAX_RETRIES=5
# NUXT_RETRY_DELAY_MS=2000
# NUXT_REDEEM_DELAY_MS=1000
# NUXT_MIN_REQUEST_INTERVAL_MS=3000
# NUXT_SEARCH_REQUEST_INTERVAL_MS=2000

# Scheduler
# NUXT_REDEMPTION_INTERVAL_MINUTES=2
# NUXT_DISCOVERY_INTERVAL_MINUTES=15
# NUXT_BACKUP_INTERVAL_HOURS=6

# Logging: error | warn | info | debug
# LOG_LEVEL=info
